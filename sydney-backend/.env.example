# API
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
AUTH_BASE_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Data stores
DATABASE_URL=postgresql://sydney:sydney@localhost:5432/sydney_dev
REDIS_URL=redis://localhost:6379
# Keep true for a single API deployment. Set false only when a dedicated
# `npm run start:worker` service is deployed alongside it.
RUN_AGENT_WORKER_IN_API=true

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=

# Later milestones
ANTHROPIC_API_KEY=
# Optional. Defaults to Claude Haiku 4.5.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/connectors/google/callback
MOBILE_AUTH_CALLBACK_SCHEME=sydney
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/connectors/slack/callback
# Required only when Slack Events API delivery is implemented.
SLACK_SIGNING_SECRET=
SLACK_OAUTH_SCOPES=channels:read,channels:history,groups:read,groups:history,users:read,app_mentions:read
# Provider event authentication. Use long random values and configure the same
# secrets in GitHub webhook / Google Pub/Sub push subscription settings.
GITHUB_WEBHOOK_SECRET=
GMAIL_PUBSUB_VERIFICATION_TOKEN=
# Fully-qualified topic, for example projects/my-project/topics/cuppet-gmail-events
GMAIL_PUBSUB_TOPIC=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/connectors/github/callback
# Safe default: profile and public repositories. Add `repo` only if private
# repository access is required; GitHub OAuth's `repo` scope is broad.
GITHUB_OAUTH_SCOPES=read:user

# Firebase Cloud Messaging for push notifications
# Download service account JSON from Firebase Console -> Project Settings -> Service Accounts
# Minify the JSON and paste it as a single-line string
# Example: FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT=
