# API
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
AUTH_BASE_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Data stores
DATABASE_URL=postgresql://sydney:sydney@localhost:5432/sydney_dev
REDIS_URL=redis://localhost:6379
# Legacy fallback for accounts that have not synced an OS IANA time zone yet.
# Scheduled agents otherwise use each user's saved device time zone.
AGENT_SCHEDULE_TIME_ZONE=Asia/Kolkata

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=

# Model provider. Gemini is the production default; switch to anthropic to use
# the retained Claude Messages API adapter instead.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/connectors/google/callback
MOBILE_AUTH_CALLBACK_SCHEME=sydney
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/connectors/slack/callback
# Required only when Slack Events API delivery is implemented.
SLACK_SIGNING_SECRET=
SLACK_OAUTH_SCOPES=channels:read,channels:history,groups:read,groups:history,users:read,app_mentions:read
# Provider event authentication. Use long random values and configure the same
# secrets in GitHub webhook / Google Pub/Sub push subscription settings.
GITHUB_WEBHOOK_SECRET=
# GitHub App URL slug, e.g. "cuppet" for github.com/apps/cuppet.
# When set, Connect GitHub requests repository installation before OAuth.
GITHUB_APP_SLUG=
GMAIL_PUBSUB_VERIFICATION_TOKEN=
# Fully-qualified topic, for example projects/my-project/topics/cuppet-gmail-events
GMAIL_PUBSUB_TOPIC=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/connectors/github/callback
# Safe default: profile and public repositories. Add `repo` only if private
# repository access is required; GitHub OAuth's `repo` scope is broad.
GITHUB_OAUTH_SCOPES=read:user
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_AUTHORIZATION_URL=https://api.notion.com/v1/oauth/authorize?client_id=YOUR_CLIENT_ID&response_type=code&owner=user&redirect_uri=http%3A%2F%2Flocalhost%3A3000%2Fconnectors%2Fnotion%2Fcallback
NOTION_API_VERSION=2026-03-11

# CIMD-first remote MCP access. The provider directory is an operator-managed
# JSON array; providers are never accepted directly from user-supplied URLs.
CIMD_CLIENT_IDENTITY_URL=https://api.cuppet.in/.well-known/oauth-client.json
# Production should use https://api.cuppet.in/access/oauth/callback.
MCP_OAUTH_CALLBACK_URL=http://localhost:3000/access/oauth/callback
MCP_ALLOWED_HOSTS=
MCP_MAX_RESPONSE_BYTES=1048576
# Gmail, Drive, Calendar, GitHub, Slack, Notion, and Web Search are native
# providers registered in the access directory; do not duplicate them here as
# remote MCP endpoints. Canva is built in and can be overridden here if an
# operator needs custom metadata or tool restrictions.
MCP_TRUSTED_PROVIDER_DIRECTORY=[{"provider_id":"mcp.canva","name":"Canva","description":"Search and read approved Canva designs, assets, and folders","icon_name":"Palette","category":"DESIGN & CREATIVE","endpoint":"https://mcp.canva.com/mcp","capabilities":["canva.read"],"allowed_tools":["get-assets","get-design","get-design-content","get-design-pages","get-design-thumbnail","get-export-formats","get-presenter-notes","list-brand-kits","list-comments","list-folder-items","list-replies","resolve-shortlink","search-brand-templates","search-designs","search-folders"]}]

# Firebase Cloud Messaging for push notifications
# Download service account JSON from Firebase Console -> Project Settings -> Service Accounts
# Minify the JSON and paste it as a single-line string
# Example: FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT=
# Assistant storage and retention bounds
ASSISTANT_MAX_CONFIRMED_MEMORIES=200
ASSISTANT_MAX_UNCONFIRMED_MEMORIES=200
ASSISTANT_MEMORY_SOURCE_MESSAGE_LIMIT=5
ASSISTANT_PENDING_ACTION_RETENTION_DAYS=30
ASSISTANT_AGENT_AUDIT_RETENTION_DAYS=180
# All user-visible messages are retained for exactly 30 days.
MESSAGE_RETENTION_DAYS=30
# Uploaded binaries expire after one day. Extracted context expires this many
# additional days after the binary expiry (one means about 48 hours total).
ASSISTANT_ATTACHMENT_CONTEXT_AFTER_BINARY_DAYS=1
# Stored conversational excerpts are configurable within 128-256 KB. Parsing
# may still inspect up to the separate hard 2 MB extraction ceiling.
ASSISTANT_STORED_ATTACHMENT_CONTEXT_KB=256
# Rolling per-user quota across all unexpired temporary uploads.
USER_ACTIVE_UPLOAD_FILE_LIMIT=40
USER_ACTIVE_UPLOAD_BYTES_MB=250
